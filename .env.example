# ---- Database ----
# EASIEST: in Vercel open the Storage tab -> Create Database -> Postgres. Vercel
# injects POSTGRES_URL automatically and the app picks it up — no need to set
# anything here. Or provide your own from https://neon.tech :
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Auth ----
# Optional. If unset, a stable secret is derived from the database URL so logins
# keep working. Recommended for production. Generate:  openssl rand -base64 32
# AUTH_SECRET="change-me-to-a-long-random-string"

# Optional. The account that registers with this email becomes admin. If unset,
# the FIRST account created becomes admin automatically.
# ADMIN_EMAIL="you@example.com"

# ---- Admin panel ----
# Password for the operator admin panel at /admin (approve deposits/withdrawals).
# The panel is NOT linked from the app — visit yoursite.com/admin and enter this.
# If unset, the admin panel stays locked.
ADMIN_PANEL_PASSWORD="choose-a-strong-password"

# ---- Deriv live price feed (public data, no account needed) ----
# Deriv gives 1089 as a shared test app_id. For production register your own at
# https://api.deriv.com and put its id here.
NEXT_PUBLIC_DERIV_APP_ID="1089"

# ---- Automated M-Pesa (Safaricom Daraja) — OPTIONAL ----
# Leave these unset to fall back to manual admin-approved deposits/withdrawals.
# Get credentials at https://developer.safaricom.co.ke

# sandbox | production
MPESA_ENV="sandbox"

# From your Daraja app
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""

# ---- Deposits (STK Push / Lipa na M-Pesa Online) ----
MPESA_SHORTCODE="174379"           # Paybill/Till number (174379 is the sandbox test code)
MPESA_PASSKEY=""                    # Lipa na M-Pesa Online passkey
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till)
MPESA_STK_TX_TYPE="CustomerPayBillOnline"

# ---- Withdrawals (B2C) — needed only for automated payouts ----
MPESA_B2C_SHORTCODE=""             # Defaults to MPESA_SHORTCODE if blank
MPESA_INITIATOR_NAME=""            # B2C initiator username
MPESA_SECURITY_CREDENTIAL=""       # Initiator password encrypted with Safaricom's public cert
MPESA_B2C_COMMAND="BusinessPayment" # BusinessPayment | SalaryPayment | PromotionPayment

# ---- Callbacks & currency ----
# Stable public https URL of your deployment (e.g. https://voltrix.vercel.app).
# If blank it falls back to VERCEL_URL / request origin.
MPESA_CALLBACK_BASE_URL=""
# Secret appended to callback URLs so only your callbacks are honoured.
# Generate with: openssl rand -hex 16
MPESA_CALLBACK_SECRET=""
# Wallet is in USD; M-Pesa moves KES. Conversion rate used for deposits/withdrawals.
USD_KES_RATE="130"

# ---- Card & Bank deposits — Paystack (OPTIONAL) ----
# https://dashboard.paystack.com — Settings → API Keys & Webhooks.
# Set the webhook URL there to: {PUBLIC_BASE_URL}/api/paystack/webhook
PAYSTACK_SECRET_KEY=""
# Currency Paystack charges in (KES default; USD if your account supports it).
PAYSTACK_CURRENCY="KES"

# ---- Crypto deposits — NOWPayments (OPTIONAL) ----
# https://nowpayments.io — Store Settings → API key + IPN secret.
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# ---- Public base URL (used to build all payment callback/return URLs) ----
# Your live https domain, e.g. https://voltrix.vercel.app  (falls back to VERCEL_URL).
PUBLIC_BASE_URL=""

# ---- Uganda mobile money — Collecto / cissytech (OPTIONAL) ----
# Collecto's API key is locked to ONE server IP, and Vercel's IPs rotate — so
# route through a fixed-IP RELAY that holds the key (see AbePay's /relay).
# RELAY MODE (recommended): point at the relay + set the relay secret; do NOT
# put COLLECTO_API_KEY in Vercel.
COLLECTO_BASE_URL=""          # e.g. https://165-227-173-148.nip.io/collecto
COLLECTO_USERNAME=""          # Collecto app username (case-sensitive)
COLLECTO_RELAY_SECRET=""      # shared secret your relay expects (x-relay-secret)
# DIRECT MODE (only from a whitelisted host): set the key instead of the relay secret.
# COLLECTO_API_KEY=""
# Wallet is USD; Collecto moves UGX. Conversion rate for deposits.
USD_UGX_RATE="3750"
